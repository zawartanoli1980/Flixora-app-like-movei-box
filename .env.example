# API runtime. Copy the names you need into your secure environment settings.
PORT=3001
DEMO_MODE=true
WEB_ORIGINS=http://localhost:5173
DEFAULT_COUNTRY=US

# TMDB v4 Read Access Token. Keep this token on the API server only.
# Create it at https://www.themoviedb.org/settings/api
# TMDB_API_TOKEN=your-tmdb-read-access-token
# TMDB_LANGUAGE=en-US

# Gemini AI assistant. Keep this key on the API server only.
# Create a key at https://aistudio.google.com/apikey and rotate exposed keys.
# GEMINI_API_KEY=your-new-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Optional authorized playback templates. {tmdbId} is required.
# TV episode templates may also use {season} and {episode}.
# STREAM_SERVER_1_TEMPLATE=https://stream-1.example.com/{mediaType}/{tmdbId}/video.mp4
# STREAM_SERVER_2_TEMPLATE=https://stream-2.example.com/{mediaType}/{tmdbId}/video.mp4
# STREAM_CDN_HLS_TEMPLATE=https://cdn.example.com/{mediaType}/{tmdbId}/master.m3u8

# Production PostgreSQL and OIDC configuration.
# DATABASE_URL=postgresql://user:password@host:5432/flixora
# AUTH_ISSUER=https://identity.example.com
# AUTH_AUDIENCE=flixora-api
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Signs short-lived tokens after successful adult-profile PIN verification.
# PROFILE_UNLOCK_SECRET=replace-with-a-different-32-character-random-secret

# Licensed CDN playback signing. Use separate, randomly generated secrets.
# PLAYBACK_SIGNING_SECRET=replace-with-at-least-32-random-characters
# CDN_BASE_URL=https://licensed-cdn.example.com/
