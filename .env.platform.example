# Node 24+, ffmpeg and ffprobe required. Never commit your real .env.
PORT=3201
PLATFORM_DATA_DIR=.flixora
# Trusted serving region. Restricted titles fail closed when this is unset.
PLATFORM_REGION=
# Exact mount containing authorized catalog.json and media; URLs are not allowed.
AUTHORIZED_IMPORT_ROOT=
# OAuth web client; exact HTTPS redirect in production, local URI for development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/platform/auth/google/callback
# TLS SMTP required for registration, verification, reset, Google-account password setup.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost:5173/
# Use NODE_ENV=production behind HTTPS to enforce Secure cookies.
# Initial owner is a one-time CLI operation. Supply these securely in your shell,
# run npm run owner:create, then remove them. Do not store them in a shared .env.
# OWNER_EMAIL=
# OWNER_PASSWORD=
# No payment credentials are accepted until a verified provider adapter is implemented.
